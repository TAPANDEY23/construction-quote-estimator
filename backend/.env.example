# Copy this file to .env and fill in your values
# cp .env.example .env

# ── AI providers ──────────────────────────────────────────────────────────────
# At least one provider key is required. All four gives full failover coverage.
# Priority order: first non-cooldown provider in the list is used.
AI_PROVIDER_PRIORITY=groq,gemini,cerebras,openrouter

# Groq — primary (get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — fallback 1 (get key at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Cerebras — fallback 2 (get key at cloud.cerebras.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.3-70b

# OpenRouter — fallback 3 (get key at openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# ── Database ───────────────────────────────────────────────────────────────────
# LOCAL: leave as file:local.db — no Turso account needed
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=    ← only needed when connecting to Turso cloud

# PRODUCTION (Render): use your Turso cloud values instead:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# ── CORS (optional locally) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email Verification — SMTP / Nodemailer (optional) ────────────────────────
# Without these, verification codes are printed to the backend terminal (dev mode).
#
# Gmail example (enable 2FA → create App Password at myaccount.google.com/apppasswords):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=youremail@gmail.com
# EMAIL_PASS=your_16_char_app_password
# EMAIL_FROM=Homeygo AI <youremail@gmail.com>
#
# Outlook / Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USER=youremail@outlook.com
# EMAIL_PASS=your_password
# EMAIL_FROM=Homeygo AI <youremail@outlook.com>

# ── SMS Verification — Twilio (optional) ──────────────────────────────────────
# Without these, verification codes are printed to the backend terminal (dev mode).
# Sign up at https://www.twilio.com — free trial includes test credits.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_FROM_NUMBER=+61400000000   ← a Twilio-provisioned AU phone number
# TWILIO_FROM_NUMBER=Homeygo AI     ← alphanumeric sender ID (no number needed; AU carriers may require pre-registration)

# ── Verification feature flags ────────────────────────────────────────────────
# Set to 'false' to skip that verification step on the registration page.
# Omit the line (or set to 'true') to keep it enabled.
VERIFY_EMAIL=true
VERIFY_PHONE=true

# ── Server (optional) ─────────────────────────────────────────────────────────
# PORT=3001   ← defaults to 3001 if not set
